# Heroku with the emk/rust buildpack
# (https://elements.heroku.com/buildpacks/emk/heroku-buildpack-rust): the website
# (site/), with its documentation and playground. heroku.yml (the "container" stack,
# with the Dockerfile) remains the other way to deploy it.
#
# The buildpack sources this file, installs Rust, then would run a plain `cargo
# build --release` at the root. The version published on Heroku ignores
# RUST_CARGO_BUILD_FLAGS (and only copies the binaries of target/release), so its
# build is skipped: heroku-build.sh builds the server and the islands (WebAssembly)
# of site/ instead, once Rust is installed.
# The same pinned toolchain as the Dockerfile: bump both together.
VERSION=1.99
RUST_SKIP_BUILD=1
trap 'status=$?; if [ "$status" -eq 0 ]; then ENV_DIR="$ENV_DIR" bash "$BUILD_DIR/heroku-build.sh" || exit 1; fi' EXIT
